  },
  {
   "field": "unit",
   "ko": "단위",
   "desc": "통화·배율(원/천원/백만원/천USD)·수량(주)·비율(%)·부호 관례(괄호·삼각)·표시 정밀도."
  },
  {
   "field": "basis",
   "ko": "측정기준",
   "desc": "장부/공정가치, 원금/충당금 차감 후/할인·이연 반영 후, 회계기준 조합(IFRS17×IFRS9 등), 산식 정의(분모)."
  },
  {
   "field": "status",
   "ko": "상태",
   "desc": "실제/계획/예정/잠정/가정/승인전/미산출/해당없음/판독불확실/추출실패."
  },
  {
   "field": "condition",
   "ko": "조건·예외",
   "desc": "각주 조건, 조건부 보증, 적용 제외, 정관 예외 등 의미를 뒤집을 수 있는 단서."
  },
  {
   "field": "evidence",
   "ko": "근거",
   "desc": "판정에 사용한 원문 구간·검사 ID·독립 대조 여부."
